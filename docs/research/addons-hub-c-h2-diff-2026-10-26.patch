diff --git a/iosApp/NuvioTV/DesignSystem/QRCode.swift b/iosApp/NuvioTV/DesignSystem/QRCode.swift
new file mode 100644
index 000000000..edbda3d8e
--- /dev/null
+++ b/iosApp/NuvioTV/DesignSystem/QRCode.swift
@@ -0,0 +1,21 @@
+import CoreImage
+import UIKit
+
+/// Add-ons hub C, H2: renders a string as a sharp QR code (the Detail sheet's Configure section).
+/// The body of `QrSignInViewModel.makeQrImage`, lifted unchanged so a second screen can use it;
+/// the two older private copies (`QrSignInView`, `RemoteSetupView`) are deliberately left alone.
+enum QRCode {
+    /// A QR image for `string` at error-correction level M, upscaled by `scale` with a
+    /// nearest-neighbour affine transform so the modules stay crisp. nil when the filter or the
+    /// image cannot be produced.
+    static func image(for string: String, scale: CGFloat = 14) -> UIImage? {
+        guard let filter = CIFilter(name: "CIQRCodeGenerator") else { return nil }
+        filter.setValue(Data(string.utf8), forKey: "inputMessage")
+        filter.setValue("M", forKey: "inputCorrectionLevel")
+        guard let output = filter.outputImage else { return nil }
+        // The raw QR is ~30pt; scale it up sharply (nearest-neighbor via affine transform).
+        let scaled = output.transformed(by: CGAffineTransform(scaleX: scale, y: scale))
+        guard let cgImage = CIContext().createCGImage(scaled, from: scaled.extent) else { return nil }
+        return UIImage(cgImage: cgImage)
+    }
+}
diff --git a/iosApp/NuvioTV/Screens/Addons/AddonCardView.swift b/iosApp/NuvioTV/Screens/Addons/AddonCardView.swift
new file mode 100644
index 000000000..a1a365c5a
--- /dev/null
+++ b/iosApp/NuvioTV/Screens/Addons/AddonCardView.swift
@@ -0,0 +1,166 @@
+import SharedCore
+import SwiftUI
+
+/// Add-ons hub C, H2: one installed add-on on the Sources hub. A single focus section: Left/Right
+/// stay inside the card (name area, On/Off, Up, Down, Remove), Up/Down move between cards.
+/// Identifiers address the card by POSITION only; the focus keys (`card:`, `toggle:`, `up:`,
+/// `down:`, `remove:` plus the manifest URL) are internal `@FocusState` values and never exposed.
+struct AddonCardView: View {
+    let addon: ManagedAddon
+    let index: Int
+    let count: Int
+    let isReadOnly: Bool
+    let focus: FocusState<String?>.Binding
+    let onOpen: () -> Void
+    let onToggle: () -> Void
+    let onMoveUp: () -> Void
+    let onMoveDown: () -> Void
+    let onRemove: () -> Void
+
+    var body: some View {
+        HStack(spacing: Theme.Spacing.lg) {
+            nameArea
+            Spacer(minLength: Theme.Spacing.md)
+            controls
+        }
+        .padding(Theme.Spacing.lg)
+        .background(Theme.Palette.surface, in: RoundedRectangle(cornerRadius: Theme.Radius.card, style: .continuous))
+        .focusSection()
+    }
+
+    private var nameArea: some View {
+        Button(action: onOpen) {
+            HStack(spacing: Theme.Spacing.lg) {
+                // The component's `failure:` builder (BUG-41) supplies the puzzle-piece fallback
+                // for a missing or broken logo.
+                CachedAsyncImage(string: addon.manifest?.logoUrl) {
+                    Image(systemName: "puzzlepiece.extension")
+                        .font(Theme.Font.body)
+                        .rowTextColor(secondary: true)
+                        .frame(maxWidth: .infinity, maxHeight: .infinity)
+                        .background(Theme.Palette.surfaceElevated)
+                }
+                .frame(width: 44, height: 44)
+                .clipShape(RoundedRectangle(cornerRadius: Theme.Radius.chip))
+
+                VStack(alignment: .leading, spacing: Theme.Spacing.xxs) {
+                    Text(AddonsViewModel.displayTitle(addon))
+                        .font(Theme.Font.sectionTitle).rowTextColor().lineLimit(1)
+                    Text(metaLine)
+                        .font(Theme.Font.meta).rowTextColor(secondary: true).lineLimit(1)
+                    Text(AddonsViewModel.host(of: addon.manifestUrl))
+                        .font(Theme.Font.caption).rowTextColor(secondary: true).lineLimit(1)
+                    if let manifest = addon.manifest {
+                        Text("Catalogs: \(manifest.catalogs.count)")
+                            .font(Theme.Font.caption).rowTextColor(secondary: true)
+                    }
+                }
+                Spacer(minLength: Theme.Spacing.md)
+                AddonStatusPill(status: AddonsViewModel.status(of: addon))
+                    .accessibilityIdentifier("addons_hub_status_\(index)")
+            }
+            .padding(Theme.Spacing.md)
+            .frame(maxWidth: .infinity, alignment: .leading)
+        }
+        .buttonStyle(.settingsRow)
+        .focused(focus, equals: "card:\(addon.manifestUrl)")
+        .accessibilityIdentifier("addons_hub_card_\(index)")
+    }
+
+    /// "v1.2.3 · Streams · Catalogs", or "Loading…" until the manifest arrives.
+    private var metaLine: String {
+        guard let manifest = addon.manifest else { return String(localized: "Loading…") }
+        let labels = AddonsViewModel.resourceLabels(of: manifest)
+        return (["v\(manifest.version)"] + labels).joined(separator: " · ")
+    }
+
+    private var controls: some View {
+        HStack(spacing: Theme.Spacing.sm) {
+            Button(action: onToggle) {
+                SettingsSwitchGlyph(isOn: addon.enabled)
+                    .padding(.horizontal, Theme.Spacing.xs)
+            }
+            .buttonStyle(.chip)
+            .focused(focus, equals: "toggle:\(addon.manifestUrl)")
+            .accessibilityLabel(addon.enabled ? Text("On") : Text("Off"))
+            .accessibilityValue(addon.enabled ? "enabled" : "disabled")
+            .accessibilityIdentifier("addons_hub_card_\(index)_toggle")
+
+            glyphButton("chevron.up", key: "up", label: "Move up", id: "up", disabled: index == 0, action: onMoveUp)
+            glyphButton("chevron.down", key: "down", label: "Move down", id: "down", disabled: index == count - 1, action: onMoveDown)
+
+            Button(action: onRemove) {
+                ErrorGlyph(systemName: "trash")
+                    .padding(.horizontal, Theme.Spacing.sm)
+            }
+            .buttonStyle(.chip)
+            .focused(focus, equals: "remove:\(addon.manifestUrl)")
+            .accessibilityLabel("Remove")
+            .accessibilityIdentifier("addons_hub_card_\(index)_remove")
+        }
+        .disabled(isReadOnly)
+    }
+
+    private func glyphButton(
+        _ symbol: String, key: String, label: LocalizedStringKey, id: String,
+        disabled: Bool, action: @escaping () -> Void
+    ) -> some View {
+        Button(action: action) {
+            Image(systemName: symbol)
+                .font(Theme.Font.body)
+                .padding(.horizontal, Theme.Spacing.sm)
+        }
+        .buttonStyle(.chip)
+        .disabled(disabled)
+        .focused(focus, equals: "\(key):\(addon.manifestUrl)")
+        .accessibilityLabel(label)
+        .accessibilityIdentifier("addons_hub_card_\(index)_\(id)")
+    }
+}
+
+/// The card's state pill: "Active", "Disabled", "Refreshing" (with a spinner) or "Unavailable".
+/// Inside the name button, so on focus it sits on the near-white platter: the resting dark pill
+/// swaps to a light-grey one then (read from `settingsRowIsFocused`, the kit's focus signal).
+private struct AddonStatusPill: View {
+    let status: AddonsViewModel.AddonStatus
+    @Environment(\.settingsRowIsFocused) private var onPlatter
+
+    private var word: String {
+        switch status {
+        case .active: return String(localized: "Active")
+        case .disabled: return String(localized: "Disabled")
+        case .refreshing: return String(localized: "Refreshing")
+        case .unavailable: return String(localized: "Unavailable")
+        }
+    }
+
+    private var fill: Color {
+        if status == .unavailable { return Theme.Palette.error.opacity(0.18) }
+        return onPlatter ? Color.black.opacity(0.1) : Theme.Palette.surfaceElevated
+    }
+
+    var body: some View {
+        HStack(spacing: Theme.Spacing.xs) {
+            if status == .refreshing { ProgressView().controlSize(.small) }
+            Text(word).font(Theme.Font.caption).rowTextColor()
+        }
+        .padding(.horizontal, Theme.Spacing.sm)
+        .padding(.vertical, Theme.Spacing.xxs)
+        .background(Capsule().fill(fill))
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel(word)
+    }
+}
+
+/// A glyph in the error tint at rest that joins the platter's dark label colour on focus (an
+/// explicit tint would stay red-on-white; the kit's `rowAccentTint` is accent-only).
+private struct ErrorGlyph: View {
+    let systemName: String
+    @Environment(\.settingsRowIsFocused) private var focused
+
+    var body: some View {
+        Image(systemName: systemName)
+            .font(Theme.Font.body)
+            .foregroundStyle(focused ? Theme.Palette.onFocusPlatter : Theme.Palette.error)
+    }
+}
diff --git a/iosApp/NuvioTV/Screens/Addons/AddonDetailSheet.swift b/iosApp/NuvioTV/Screens/Addons/AddonDetailSheet.swift
new file mode 100644
index 000000000..6570d25a5
--- /dev/null
+++ b/iosApp/NuvioTV/Screens/Addons/AddonDetailSheet.swift
@@ -0,0 +1,188 @@
+import SharedCore
+import SwiftUI
+
+/// Add-ons hub C, H2: the sheet opened by pressing an add-on's name area. Reads the add-on LIVE
+/// from `model` (a refresh started here updates the sheet in place) and falls back to the
+/// snapshot it was opened with, so the sheet never blanks mid-removal. Remove hands back to the
+/// hub, which dismisses the sheet before it raises the confirm alert (an alert cannot present
+/// over a sheet).
+struct AddonDetailSheet: View {
+    @ObservedObject var model: AddonsViewModel
+    let snapshot: ManagedAddon
+    let isReadOnly: Bool
+    let onRemove: () -> Void
+
+    @State private var showsConfigure = false
+    /// The rendered QR and the URL it was built for; rebuilt only when that URL changes.
+    @State private var qrImage: UIImage?
+    @State private var qrFor: String?
+
+    private var addon: ManagedAddon {
+        model.addons.first { $0.manifestUrl == snapshot.manifestUrl } ?? snapshot
+    }
+
+    var body: some View {
+        let addon = addon
+        ScrollView {
+            VStack(alignment: .leading, spacing: Theme.Spacing.lg) {
+                Text(AddonsViewModel.displayTitle(addon)).font(Theme.Font.screenTitle)
+                if let manifest = addon.manifest {
+                    if !manifest.description.isEmpty {
+                        Text(manifest.description).font(Theme.Font.body).lineLimit(6)
+                    }
+                    Text(versionLine(manifest)).font(Theme.Font.meta)
+                    Text(AddonsViewModel.resourceLabels(of: manifest).joined(separator: " · ")).font(Theme.Font.meta)
+                    catalogList(manifest)
+                } else {
+                    Text("Loading…").font(Theme.Font.meta).foregroundStyle(Theme.Palette.textSecondary)
+                }
+                Text(Self.locationLine(addon.manifestUrl))
+                    .font(Theme.Font.caption).foregroundStyle(Theme.Palette.textSecondary)
+                    .accessibilityIdentifier("addons_hub_detail_location")
+                buttons(addon)
+                if showsConfigure, addon.manifest?.behaviorHints.configurable == true {
+                    configureSection(addon)
+                }
+            }
+            .padding(Theme.Spacing.screen)
+            .frame(maxWidth: .infinity, alignment: .leading)
+        }
+        .accessibilityIdentifier("addons_hub_detail_sheet")
+        .task(id: qrKey(addon)) {
+            let key = qrKey(addon)
+            guard !key.isEmpty, key != qrFor else { return }
+            qrImage = Self.makeQR(key)
+            qrFor = key
+        }
+    }
+
+    /// The configure URL while the QR is wanted, else "" (nothing to build).
+    private func qrKey(_ addon: ManagedAddon) -> String {
+        showsConfigure && addon.manifest?.behaviorHints.configurable == true
+            ? Self.configureUrl(addon.manifestUrl) : ""
+    }
+
+    /// Review r1: the module count comes from a scale-1 render; the final scale is the largest
+    /// whole number that fits 320 pt (minimum 1), so every module lands on whole pixels.
+    private static func makeQR(_ url: String) -> UIImage? {
+        guard let raw = QRCode.image(for: url, scale: 1), let width = raw.cgImage?.width, width > 0 else { return nil }
+        return QRCode.image(for: url, scale: CGFloat(max(1, 320 / width)))
+    }
+
+    private func versionLine(_ manifest: AddonManifest) -> String {
+        String(localized: "Version \(manifest.version)") + " · " + manifest.types.joined(separator: ", ")
+    }
+
+    @ViewBuilder
+    private func catalogList(_ manifest: AddonManifest) -> some View {
+        if !manifest.catalogs.isEmpty {
+            VStack(alignment: .leading, spacing: Theme.Spacing.xxs) {
+                Text("Catalogs").font(Theme.Font.cardTitle)
+                ForEach(Array(manifest.catalogs.prefix(12).enumerated()), id: \.offset) { _, catalog in
+                    Text(catalog.name).font(Theme.Font.caption)
+                }
+                if manifest.catalogs.count > 12 {
+                    Text("+\(manifest.catalogs.count - 12) more")
+                        .font(Theme.Font.caption).foregroundStyle(Theme.Palette.textSecondary)
+                }
+            }
+        }
+    }
+
+    private func buttons(_ addon: ManagedAddon) -> some View {
+        HStack(spacing: Theme.Spacing.md) {
+            Button {
+                model.refresh(manifestUrl: addon.manifestUrl)
+            } label: {
+                Label("Refresh", systemImage: "arrow.clockwise").padding(.horizontal, Theme.Spacing.sm)
+            }
+            .buttonStyle(.borderedProminent)
+            .accessibilityIdentifier("addons_hub_detail_refresh")
+
+            Button(action: onRemove) {
+                Label("Remove", systemImage: "trash").padding(.horizontal, Theme.Spacing.sm)
+            }
+            .buttonStyle(.bordered)
+            .disabled(isReadOnly)
+            .accessibilityIdentifier("addons_hub_detail_remove")
+
+            if addon.manifest?.behaviorHints.configurable == true {
+                Button {
+                    showsConfigure.toggle()
+                } label: {
+                    Label("Configure", systemImage: "qrcode").padding(.horizontal, Theme.Spacing.sm)
+                }
+                .buttonStyle(.bordered)
+                .accessibilityIdentifier("addons_hub_detail_configure")
+            }
+        }
+        .focusSection()
+    }
+
+    @ViewBuilder
+    private func configureSection(_ addon: ManagedAddon) -> some View {
+        let url = Self.configureUrl(addon.manifestUrl)
+        VStack(alignment: .leading, spacing: Theme.Spacing.md) {
+            Text("Scan to configure this add-on on your phone.").font(Theme.Font.body)
+            if qrFor == url, let image = qrImage {
+                // The frame is the image's own whole-pixel size (at most 320 pt): no resampling.
+                Image(uiImage: image)
+                    .interpolation(.none)
+                    .resizable()
+                    .frame(width: image.size.width, height: image.size.height)
+                    .accessibilityIdentifier("addons_hub_detail_qr")
+            }
+            // The QR carries the full URL (that is its job); the caption shows the host only, the
+            // key stays off the screen.
+            Text(AddonsViewModel.host(of: url) + "/…/configure")
+                .font(Theme.Font.caption).foregroundStyle(Theme.Palette.textSecondary)
+        }
+    }
+
+    /// Where the add-on lives, without its key. Debrid keys live in the PATH of most add-on URLs
+    /// (`/torbox=KEY/manifest.json`) as well as the query, so the path is never shown: the file
+    /// name appears only when it is exactly `manifest.json`, otherwise just "host/…". "(key
+    /// hidden)" is appended whenever anything was dropped (path segments, query or userinfo). A
+    /// `#fragment` is stripped first; a bare host renders as the host alone.
+    static func locationLine(_ manifestUrl: String) -> String {
+        let host = AddonsViewModel.host(of: manifestUrl)
+        let noFragment = manifestUrl.split(separator: "#", maxSplits: 1, omittingEmptySubsequences: false)
+            .first.map(String.init) ?? manifestUrl
+        let hasQuery = noFragment.contains("?")
+        let withoutQuery = noFragment.split(separator: "?", maxSplits: 1, omittingEmptySubsequences: false)
+            .first.map(String.init) ?? noFragment
+        var rest = Substring(withoutQuery)
+        if let sep = rest.range(of: "://"), sep.lowerBound < (rest.firstIndex(of: "/") ?? rest.endIndex) {
+            rest = rest[sep.upperBound...]
+        }
+        let authorityEnd = rest.firstIndex(of: "/") ?? rest.endIndex
+        let hasUserinfo = rest[..<authorityEnd].contains("@")
+        let segments = rest[authorityEnd...].split(separator: "/").map(String.init)
+        let hidden = hasQuery || hasUserinfo || segments.count > 1
+            || (segments.count == 1 && segments[0] != "manifest.json")
+        let base: String
+        if segments.isEmpty {
+            base = host
+        } else if segments.last == "manifest.json" {
+            base = segments.count == 1 ? "\(host)/manifest.json" : "\(host)/…/manifest.json"
+        } else {
+            base = "\(host)/…"
+        }
+        return hidden ? base + " " + String(localized: "(key hidden)") : base
+    }
+
+    /// The manifest URL with a trailing `/manifest.json` (before any query) swapped for
+    /// `/configure`, query kept. A URL without that suffix gets `/configure` appended to its path.
+    static func configureUrl(_ manifestUrl: String) -> String {
+        let split = manifestUrl.firstIndex(of: "?")
+        let path = split.map { String(manifestUrl[..<$0]) } ?? manifestUrl
+        let query = split.map { String(manifestUrl[$0...]) } ?? ""
+        let trimmed: String
+        if path.hasSuffix("/manifest.json") {
+            trimmed = String(path.dropLast("/manifest.json".count))
+        } else {
+            trimmed = path.hasSuffix("/") ? String(path.dropLast()) : path
+        }
+        return trimmed + "/configure" + query
+    }
+}
diff --git a/iosApp/NuvioTV/Screens/Addons/AddonInstallSheet.swift b/iosApp/NuvioTV/Screens/Addons/AddonInstallSheet.swift
new file mode 100644
index 000000000..c625e58e1
--- /dev/null
+++ b/iosApp/NuvioTV/Screens/Addons/AddonInstallSheet.swift
@@ -0,0 +1,76 @@
+import SwiftUI
+
+/// Add-ons hub C, H2: the install flow, moved verbatim out of the old Add-ons screen into a sheet
+/// (H3 polishes it). Today's field, Install button, DEBUG quick-install chip, spinner and status
+/// line are unchanged. New: a title, the identifiers the hub's UI legs address, and a self-dismiss
+/// 1.2 s after a typed `.installed` outcome (never the localized status text) so the viewer lands back on the list with the new card.
+struct AddonInstallSheet: View {
+    @ObservedObject var model: AddonsViewModel
+    @State private var newUrl = ""
+    @Environment(\.dismiss) private var dismiss
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: Theme.Spacing.md) {
+            Text("Install add-on").font(Theme.Font.screenTitle)
+            Text("Paste the manifest URL from your streaming addon's config page (e.g. your TorBox or Torrentio URL with your API key). It ends in /manifest.json.")
+                .font(Theme.Font.body).foregroundStyle(.secondary)
+                .frame(maxWidth: 1200, alignment: .leading)
+
+            HStack(spacing: Theme.Spacing.md) {
+                Image(systemName: "link").foregroundStyle(.secondary)
+                TextField("https://\u{2026}/manifest.json", text: $newUrl)
+                    .textFieldStyle(.plain)
+                    .font(Theme.Font.screenTitle.weight(.regular))
+                    .accessibilityIdentifier("addons_hub_install_field")
+            }
+            .padding(20)
+            .glassEffect(.regular, in: RoundedRectangle(cornerRadius: 12))
+
+            HStack(spacing: 20) {
+                // Not `.disabled` while installing: that disabled the button the user had just
+                // pressed and focus jumped away. Guarded in the action instead.
+                Button {
+                    guard !model.isInstalling else { return }
+                    model.install(newUrl)
+                    newUrl = ""
+                } label: {
+                    Label("Install", systemImage: "plus.circle.fill")
+                        .padding(.horizontal, 16).padding(.vertical, 6)
+                }
+                .buttonStyle(.borderedProminent)
+                .accessibilityIdentifier("addons_hub_install_button")
+
+                #if DEBUG
+                if DebugConfig.hasManifestURL {
+                    Button {
+                        guard !model.isInstalling else { return }
+                        model.install(DebugConfig.manifestURL)
+                    } label: {
+                        Label("Quick install (from DebugConfig)", systemImage: "wrench.and.screwdriver")
+                            .padding(.horizontal, 16).padding(.vertical, 6)
+                    }
+                    .buttonStyle(.chip)
+                }
+                #endif
+
+                if model.isInstalling { ProgressView() }
+                if let status = model.statusMessage {
+                    Text(status).font(Theme.Font.body).foregroundStyle(.secondary)
+                        .accessibilityIdentifier("addons_hub_install_status")
+                }
+            }
+        }
+        .padding(Theme.Spacing.screen)
+        .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .topLeading)
+        .focusSection()
+        // Cancelled with the sheet (or by a newer outcome), so an early dismissal followed by a
+        // reopen never closes the new sheet. H3 refines this; 1.2 s is long enough to read the
+        // confirmation.
+        .task(id: model.installOutcome) {
+            guard case .installed = model.installOutcome else { return }
+            try? await Task.sleep(nanoseconds: 1_200_000_000)
+            guard !Task.isCancelled else { return }
+            dismiss()
+        }
+    }
+}
diff --git a/iosApp/NuvioTV/Screens/Addons/SourcesHubView.swift b/iosApp/NuvioTV/Screens/Addons/SourcesHubView.swift
new file mode 100644
index 000000000..aaa17b055
--- /dev/null
+++ b/iosApp/NuvioTV/Screens/Addons/SourcesHubView.swift
@@ -0,0 +1,481 @@
+import SharedCore
+import SwiftUI
+
+/// Where a summary card pushes. `catalogs` is the Home Screen pane for now (H4 swaps in the
+/// catalog order page).
+enum HubRoute: Hashable {
+    case catalogs, services, plugins
+}
+
+/// Add-ons hub C, H2: the Sources hub page body, called by `AddonsView`. A summary row (Add-ons,
+/// Catalogs, Debrid, Plugins), an action row (Install, Refresh all, Manage from phone) and the
+/// installed add-on cards. `AddonsView` owns every store (started and stopped on the stack) and
+/// the remove confirmation; this view observes them. The Services pane's disconnect alerts hang
+/// off the pushed pane itself, with their state kept here.
+///
+/// Plural wording below is deliberately inflection-free ("Repositories: 1 · Providers: 7");
+/// H5's catalog pass may add proper plural rules.
+struct SourcesHubView: View {
+    @ObservedObject var model: AddonsViewModel
+    @ObservedObject var settings: SettingsViewModel
+    @ObservedObject var debrid: DebridViewModel
+    @ObservedObject var plugins: PluginsViewModel
+    @ObservedObject var badges: BadgeSettingsViewModel
+    @ObservedObject var trakt: TraktViewModel
+    @ObservedObject var simkl: SimklViewModel
+    @Binding var path: [HubRoute]
+    @Binding var pendingRemoval: ManagedAddon?
+    @Binding var removal: RemovalIntent?
+
+    @FocusState private var focusedControl: String?
+    @Namespace private var focusNamespace
+    @State private var showInstall = false
+    @State private var detailTarget: DetailTarget?
+    /// The add-on whose Remove was pressed in the Detail sheet; promoted to `pendingRemoval` once
+    /// the sheet has finished dismissing (an alert cannot present over a sheet).
+    @State private var pendingFromSheet: ManagedAddon?
+    /// Set when an install succeeds while the sheet is up; the sheet's dismissal then focuses the
+    /// new card.
+    @State private var focusNewCardAfterInstall = false
+    @State private var toast: String?
+    /// Counts toasts shown; the timed clear keys on it, not on the text, so a repeat of the same
+    /// text keeps its full time.
+    @State private var toastSerial = 0
+    // The Services pane's disconnect confirmations, hosted on the pushed pane (SettingsView hosts
+    // them for its own copy).
+    @State private var confirmingTraktDisconnect = false
+    @State private var confirmingSimklDisconnect = false
+    @State private var debridDisconnectId: String?
+
+    struct DetailTarget: Identifiable {
+        let addon: ManagedAddon
+        var id: String { addon.manifestUrl }
+    }
+
+    struct RemovalIntent {
+        let url: String
+        let name: String
+        let nextUrl: String?
+        let previousUrl: String?
+    }
+
+    var body: some View {
+        let summary = AddonsViewModel.summary(
+            addons: model.addons,
+            catalogs: settings.catalogs,
+            debridConnectedNames: debrid.providers.filter { debrid.isConnected($0.id) }.map(\.displayName),
+            pluginsEnabled: plugins.pluginsEnabled,
+            pluginRepositories: plugins.repositories.count,
+            pluginProviders: plugins.scrapers.count
+        )
+        ScrollViewReader { proxy in
+            ScrollView(.vertical) {
+                LazyVStack(alignment: .leading, spacing: Theme.Spacing.sectionGap) {
+                    Text("Add-ons")
+                        .font(Theme.Font.screenTitle)
+                        .foregroundStyle(Theme.Palette.textPrimary)
+                        .accessibilityIdentifier("addons_hub_title")
+                    summaryRow(summary, proxy: proxy)
+                    actionRow
+                    installedSection
+                }
+                .padding(Theme.Spacing.screen)
