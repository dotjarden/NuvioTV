+                    .font(Theme.Font.body).foregroundStyle(Theme.Palette.textSecondary)
+                    .accessibilityIdentifier("addons_hub_readonly")
+            }
+            ForEach(Array(model.addons.enumerated()), id: \.element.manifestUrl) { index, addon in
+                AddonCardView(
